{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-configure-vs2026-x64",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-vs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "cmake-build-debug-main",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "windows-vs-debug",
        "--target",
        "FreeCADMbDMain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "cmake-build-debug-main-configure",
      "dependsOn": [
        "cmake-configure-vs2026-x64",
        "cmake-build-debug-main"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

