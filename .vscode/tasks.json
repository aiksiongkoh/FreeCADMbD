{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-configure-vs2022-x64",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build-vcpkg",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64",
        "-DCMAKE_TOOLCHAIN_FILE=C:/Users/askoh/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "-DFREECADMBD_BUILD_EXE=ON",
        "-DFREECADMBD_BUILD_TESTS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "cmake-build-debug-main",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-vcpkg",
        "--config",
        "Debug",
        "--target",
        "FreeCADMbDMain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "cmake-build-debug-main-configure",
      "dependsOn": [
        "cmake-configure-vs2022-x64",
        "cmake-build-debug-main"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}


