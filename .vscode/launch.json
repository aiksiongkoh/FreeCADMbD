{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FreeCADMbDMain (no args, fast no build)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vs/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug FreeCADMbDMain (no args, build first)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vs/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main"
    },
    {
      "name": "Debug FreeCADMbDMain (.asmt, fast no build)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vs/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [
        "${input:asmtFile}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal"
    },
