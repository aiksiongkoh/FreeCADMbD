{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FreeCADMbDMain (no args)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main-configure"
    },
    {
      "name": "Debug FreeCADMbDMain (no args, build first)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main-configure"
    },
    {
      "name": "Debug FreeCADMbDMain (.asmt)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [
        "${input:asmtFile}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main-configure"
    },
    {
      "name": "Debug FreeCADMbDMain (.asmt, build first)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [
        "C:/Users/askoh/Documents/GitHub/aiksiongkoh/FreeCAD/feature-mbdfem/data/examples/RealisticPendulumMbDFEM3.asmt"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main-configure"
    },
    {
      "name": "Debug FreeCADMbDMain (.mbd)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [
        "${input:mbdFile}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main-configure"
    },
    {
      "name": "Debug FreeCADMbDMain (.mbd, build first)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/FreeCADMbDMain/Debug/FreeCADMbDMain.exe",
      "args": [
        "${input:mbdFile}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "cmake-build-debug-main-configure"
    },
    {
      "name": "Debug test_run fourbot",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vcpkg/tests/Debug/test_run.exe",
      "args": [
        "--gtest_filter=FreeCADMbD.fourbot"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "CMake Tools: Debug CTest (Selected Test)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${cmake.testProgram}",
      "args": [
        "${cmake.testArgs}"
      ],
      "cwd": "${cmake.testWorkingDirectory}",
      "stopAtEntry": false,
      "environment": [],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "asmtFile",
      "type": "promptString",
      "description": "Path to .asmt file (relative to workspace or absolute)",
      "default": "testapp/ASMT/piston.asmt"
    },
    {
      "id": "mbdFile",
      "type": "promptString",
      "description": "Path to .mbd file (relative to workspace or absolute)",
      "default": "testapp/MBDyn/CrankSlider2.mbd"
    }
  ]
}
