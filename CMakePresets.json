{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs-vcpkg",
      "displayName": "Windows VS 2022 x64 with vcpkg",
      "description": "Visual Studio 2022 x64 build using the vcpkg toolchain.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "FREECADMBD_BUILD_TESTS": "ON",
        "FREECADMBD_BUILD_EXE": "ON"
      }
    },
    {
      "name": "windows-vs",
      "displayName": "Windows VS 2022 x64",
      "description": "Visual Studio 2022 x64 build without a package-manager toolchain.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "FREECADMBD_BUILD_TESTS": "ON",
        "FREECADMBD_BUILD_EXE": "ON"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows Ninja Debug",
      "description": "Single-config Ninja Debug build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FREECADMBD_BUILD_TESTS": "ON",
        "FREECADMBD_BUILD_EXE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs-vcpkg-debug",
      "displayName": "Build Windows VS vcpkg Debug",
      "configurePreset": "windows-vs-vcpkg",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs-vcpkg-release",
      "displayName": "Build Windows VS vcpkg Release",
      "configurePreset": "windows-vs-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "windows-vs-debug",
      "displayName": "Build Windows VS Debug",
      "configurePreset": "windows-vs",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs-release",
      "displayName": "Build Windows VS Release",
      "configurePreset": "windows-vs",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Build Windows Ninja Debug",
      "configurePreset": "windows-ninja-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs-vcpkg-debug",
      "displayName": "Test Windows VS vcpkg Debug",
      "configurePreset": "windows-vs-vcpkg",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs-debug",
      "displayName": "Test Windows VS Debug",
      "configurePreset": "windows-vs",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Test Windows Ninja Debug",
      "configurePreset": "windows-ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
