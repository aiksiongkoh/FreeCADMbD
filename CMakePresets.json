{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs",
      "displayName": "Windows VS 2026 x64 (MSVC)",
      "description": "Visual Studio 2026 with the Microsoft v145 toolset and C++20.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "FREECADMBD_BUILD_TESTS": "ON",
        "FREECADMBD_BUILD_EXE": "ON"
      },
      "toolset": "v145,host=x64"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs-debug",
      "displayName": "Build Windows VS Debug",
      "configurePreset": "windows-vs",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs-release",
      "displayName": "Build Windows VS Release",
      "configurePreset": "windows-vs",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs-debug",
      "displayName": "Test Windows VS Debug",
      "configurePreset": "windows-vs",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "configuration": "Release",
      "name": "windows-vs-release",
      "execution": {
        "jobs": 1
      },
      "configurePreset": "windows-vs",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
