# Keep repository text normalized while making Windows-facing project files
# check out with consistent CRLF endings.
* text=auto

# C/C++ source
*.c text eol=crlf
*.cc text eol=crlf
*.cpp text eol=crlf
*.cxx text eol=crlf
*.h text eol=crlf
*.hh text eol=crlf
*.hpp text eol=crlf
*.hxx text eol=crlf
*.inl text eol=crlf

# Build and IDE files commonly edited on Windows
*.cmake text eol=crlf
CMakeLists.txt text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell/scripts/docs stay LF
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
